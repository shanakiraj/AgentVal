# Copy to .env.local (git-ignored). On Vercel, set these in Project Settings -> Environment Variables.

# Public base URL of the AgentVal FastAPI backend. Leave unset to serve bundled demo data.
NEXT_PUBLIC_API_URL=
# Optional server-only override, read at runtime (e.g. http://api:8000 in docker-compose).
API_URL=
# Force read-only demo mode even when an API URL is configured.
NEXT_PUBLIC_DEMO_MODE=false
