# Copy to .env (git-ignored) and adjust. Never commit real credentials.

# --- docker-compose / Postgres (local dev defaults) ---
POSTGRES_USER=agentval
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentval

# --- API (packages/core-python) ---
# SQLite by default when running outside docker; any Postgres URL works (Neon / Supabase too).
DATABASE_URL=sqlite:///./agentval.db
AGENTVAL_SEED=true
CORS_ORIGINS=http://localhost:3000

# Optional model provider keys, read by LiteLLM. Not needed for the mock demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Web (apps/web) ---
# Public base URL of the AgentVal API. Leave unset to show bundled demo data.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only override (e.g. http://api:8000 inside docker-compose).
API_URL=
# Force read-only demo mode even if an API URL is set.
NEXT_PUBLIC_DEMO_MODE=false
