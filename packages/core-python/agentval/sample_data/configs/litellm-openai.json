{
  "name": "gpt-4o-mini tool agent (needs OPENAI_API_KEY)",
  "concurrency": 4,
  "max_retries": 2,
  "retry_base_delay": 0.2,
  "pass_threshold": 0.85,
  "partial_threshold": 0.4,
  "scorers": [
    {
      "type": "exact_match",
      "params": {
        "field": "resolution"
      }
    },
    {
      "type": "schema_match"
    },
    {
      "type": "llm_judge",
      "weight": 2,
      "params": {
        "model": "gpt-4o-mini"
      }
    },
    {
      "type": "trajectory"
    }
  ],
  "agent": {
    "type": "litellm",
    "model": "gpt-4o-mini"
  }
}