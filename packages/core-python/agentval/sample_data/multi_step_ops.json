{
  "name": "Multi-step Operations",
  "description": "Multi-intent requests that need several dependent tool calls in the right order, plus error recovery when a lookup fails. Scored mainly on trajectory correctness and efficiency.",
  "testCases": [
    {
      "name": "Two orders, two intents",
      "input": {
        "prompt": "Order F6006 arrived damaged and G7007 still hasn't shown up. Can you help with both?",
        "context": {
          "customer": {
            "name": "Jamie Rivera",
            "email": "jamie@example.com",
            "tier": "gold"
          },
          "orders": {
            "F6006": {
              "order_id": "F6006",
              "status": "delivered",
              "carrier": "UPS",
              "tracking": "1Z11100022223333",
              "eta": "delivered",
              "total": 72.0,
              "customer_email": "jamie@example.com"
            },
            "G7007": {
              "order_id": "G7007",
              "status": "shipped",
              "carrier": "FedEx",
              "tracking": "7799 0000 1111",
              "eta": "Saturday",
              "total": 18.0,
              "customer_email": "jamie@example.com"
            }
          }
        },
        "tools": [
          "lookup_order",
          "issue_refund",
          "send_password_reset",
          "update_shipping_address",
          "create_ticket",
          "escalate_to_human"
        ],
        "system": "You are the customer service agent for an online store. Use tools to act; never invent order details. Handle every request in the message. Always lookup_order before changing or refunding an order. Damaged items: issue_refund. Missing items from a delivered box: create_ticket with queue \"missing_item\" (resolution \"escalated\"). Address changes are allowed only before shipment via update_shipping_address. Locked-out customers: send_password_reset. If an order cannot be found, ask the customer to confirm the order number (resolution \"needs_info\"). Reply with ONLY a JSON object, no prose and no code fences: {\"reply\": str, \"resolution\": \"resolved\"|\"escalated\"|\"needs_info\", \"actions\": [str]}."
      },
      "expected": {
        "resolution": "resolved",
        "reply_contains": [
          "72",
          "7799 0000 1111"
        ],
        "tool_calls": [
          {
            "name": "lookup_order",
            "args": {
              "order_id": "F6006"
            }
          },
          {
            "name": "issue_refund",
            "args": {
              "order_id": "F6006"
            }
          },
          {
            "name": "lookup_order",
            "args": {
              "order_id": "G7007"
            }
          }
        ],
        "max_steps": 6,
        "schema": {
          "type": "object",
          "required": [
            "reply",
            "resolution",
            "actions"
          ],
          "properties": {
            "reply": {
              "type": "string",
              "minLength": 1
            },
            "resolution": {
              "type": "string",
              "enum": [
                "resolved",
                "escalated",
                "needs_info"
              ]
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "metadata": {
        "category": "operations",
        "difficulty": "hard",
        "tags": [
          "multi-intent",
          "multi-tool"
        ],
        "rationale": "Both intents must be handled; agents often stop after the first."
      }
    },
